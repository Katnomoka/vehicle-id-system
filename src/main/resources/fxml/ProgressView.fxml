<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vehicle.identification.vehicleidsystem.controller.ProgressViewController"
            fitToWidth="true" fitToHeight="true"
            style="-fx-background-color: #f4f7f6; -fx-background: #f4f7f6;">

    <VBox spacing="25.0" style="-fx-padding: 30;">

        <!-- Header -->
        <VBox spacing="5.0">
            <Label text="System Overview" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2d3436;"/>
            <Label text="Real-time monitoring of vehicle identification modules"
                   style="-fx-font-size: 14px; -fx-text-fill: #b2bec3;"/>
        </VBox>

        <!-- Stats Cards Row -->
        <GridPane hgap="20.0" vgap="20.0">

            <!-- Card 1 -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);"
                  GridPane.columnIndex="0">
                <Label text="🚗 Total Vehicles" style="-fx-text-fill: #636e72; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <Label fx:id="totalVehiclesLabel" text="1,240" style="-fx-text-fill: #2d3436; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
                <Label text="+12% from last month" style="-fx-text-fill: #00b894; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Card 2 -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);"
                  GridPane.columnIndex="1">
                <Label text="🛡️ Insurance Active" style="-fx-text-fill: #636e72; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <Label fx:id="insuranceLabel" text="850" style="-fx-text-fill: #2d3436; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
                <Label text="68% coverage rate" style="-fx-text-fill: #0984e3; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Card 3 -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);"
                  GridPane.columnIndex="2">
                <Label text="🔧 Service Pending" style="-fx-text-fill: #636e72; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <Label fx:id="serviceLabel" text="45" style="-fx-text-fill: #2d3436; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
                <Label text="12 urgent" style="-fx-text-fill: #d63031; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Card 4 -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);"
                  GridPane.columnIndex="3">
                <Label text="⚠️ Violations" style="-fx-text-fill: #636e72; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <Label fx:id="violationLabel" text="12" style="-fx-text-fill: #2d3436; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
                <Label text="3 unpaid fines" style="-fx-text-fill: #e17055; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </VBox>

        </GridPane>

        <!-- Middle Section: Progress & Status -->
        <GridPane hgap="25.0" vgap="25.0" VBox.vgrow="ALWAYS">

            <!-- Left: System Status -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);"
                  GridPane.columnIndex="0" GridPane.rowIndex="0">

                <Label text="⚡ System Status" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-padding: 0 0 20 0;"/>

                <!-- Status Item 1 -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                    <ProgressIndicator fx:id="databaseIndicator" progress="0.5" prefHeight="30" prefWidth="30" style="-fx-progress-color: #0984e3;"/>
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label text="Database Sync" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;"/>
                        <Label text="Last sync: 2 mins ago" style="-fx-font-size: 11px; -fx-text-fill: #b2bec3;"/>
                    </VBox>
                    <Label text="Active" style="-fx-background-color: #00b894; -fx-text-fill: white; -fx-padding: 4 10; -fx-background-radius: 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                </HBox>

                <VBox spacing="10.0" style="-fx-padding: 15 0 0 0;">
                    <!-- Status Item 2 -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                        <ProgressIndicator fx:id="backupIndicator" progress="0.3" prefHeight="30" prefWidth="30" style="-fx-progress-color: #fdcb6e;"/>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="Backup Status" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;"/>
                            <Label text="In progress: 30%" style="-fx-font-size: 11px; -fx-text-fill: #b2bec3;"/>
                        </VBox>
                        <Label text="Running" style="-fx-background-color: #fdcb6e; -fx-text-fill: #2d3436; -fx-padding: 4 10; -fx-background-radius: 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    </HBox>

                    <!-- Status Item 3 -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                        <ProgressIndicator fx:id="updateIndicator" progress="1.0" prefHeight="30" prefWidth="30" style="-fx-progress-color: #00b894;"/>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="System Update" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;"/>
                            <Label text="Updated: Today 8:00 AM" style="-fx-font-size: 11px; -fx-text-fill: #b2bec3;"/>
                        </VBox>
                        <Label text="Done" style="-fx-background-color: #00b894; -fx-text-fill: white; -fx-padding: 4 10; -fx-background-radius: 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Right: Visual Effects & Progress -->
            <VBox spacing="25.0" GridPane.columnIndex="1" GridPane.rowIndex="0">

                <!-- Progress Bars Card -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <Label text="📊 Resource Usage" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-padding: 0 0 20 0;"/>

                    <VBox spacing="15.0">
                        <VBox spacing="5.0">
                            <HBox>
                                <Label text="Storage Used" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="75%" style="-fx-font-weight: bold; -fx-text-fill: #0984e3;"/>
                            </HBox>
                            <ProgressBar progress="0.75" style="-fx-pref-height: 8px; -fx-background-color: #dfe6e9; -fx-background-radius: 4; -fx-accent: #0984e3;"/>
                        </VBox>

                        <VBox spacing="5.0">
                            <HBox>
                                <Label text="Memory Usage" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="45%" style="-fx-font-weight: bold; -fx-text-fill: #00b894;"/>
                            </HBox>
                            <ProgressBar progress="0.45" style="-fx-pref-height: 8px; -fx-background-color: #dfe6e9; -fx-background-radius: 4; -fx-accent: #00b894;"/>
                        </VBox>

                        <VBox spacing="5.0">
                            <HBox>
                                <Label text="CPU Load" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="12%" style="-fx-font-weight: bold; -fx-text-fill: #e17055;"/>
                            </HBox>
                            <ProgressBar progress="0.12" style="-fx-pref-height: 8px; -fx-background-color: #dfe6e9; -fx-background-radius: 4; -fx-accent: #e17055;"/>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- Visual Effects Card -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);" VBox.vgrow="ALWAYS">
                    <Label text="🎨 Visual Effects" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-padding: 0 0 20 0;"/>

                    <HBox spacing="15.0" alignment="CENTER">
                        <Button fx:id="dropShadowButton" text="DropShadow" onAction="#handleDropShadowClick"
                                style="-fx-background-color: #2d3436; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 20; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Fade Effect" onAction="#handleFadeClick"
                                style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 20; -fx-cursor: hand;"/>
                    </HBox>
                    <Label text="Click to test animations" style="-fx-text-fill: #b2bec3; -fx-font-size: 11px; -fx-padding: 15 0 0 0;"/>
                </VBox>
            </VBox>

        </GridPane>

        <!-- Bottom: Active Modules Grid (3 Columns) -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <Label text="📦 Active Modules" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-padding: 0 0 20 0;"/>

            <GridPane hgap="15.0" vgap="12.0">
                <!-- Row 1 -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <Label text="01" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="Vehicle Registration" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <Label text="02" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="Service Management" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="0" GridPane.columnIndex="2">
                    <Label text="03" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="Insurance Tracking" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

                <!-- Row 2 -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="1" GridPane.columnIndex="0">
                    <Label text="04" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="Police Reports" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <Label text="05" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="Customer Queries" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="1" GridPane.columnIndex="2">
                    <Label text="06" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="Violation Mgmt" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

                <!-- Row 3 -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="2" GridPane.columnIndex="0">
                    <Label text="07" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="Claim Processing" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <Label text="08" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="User Management" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="2" GridPane.columnIndex="2">
                    <Label text="09" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="Analytics" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

                <!-- Row 4 -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="3" GridPane.columnIndex="0">
                    <Label text="10" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="Workshop Module" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="3" GridPane.columnIndex="1">
                    <Label text="11" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="Report Generator" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;"
                      GridPane.rowIndex="3" GridPane.columnIndex="2">
                    <Label text="12" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-pref-width: 28; -fx-background-color: #0984e3; -fx-padding: 3 8; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                    <Label text="Settings" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" HBox.hgrow="ALWAYS"/>
                    <Label text="●" style="-fx-text-fill: #00b894; -fx-font-size: 16px;"/>
                </HBox>

            </GridPane>
        </VBox>

    </VBox>
</ScrollPane>