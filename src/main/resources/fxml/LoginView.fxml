<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.vehicle.identification.vehicleidsystem.controller.LoginController"
           prefWidth="900.0" prefHeight="600.0"
           style="-fx-background-color: linear-gradient(to bottom right, #667eea 0%, #764ba2 100%);">

    <!-- Main Container -->
    <HBox alignment="CENTER" spacing="0.0" StackPane.alignment="CENTER">

        <!-- Left Side - Branding -->
        <VBox alignment="CENTER" spacing="20.0"
              style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-background-radius: 20 0 0 20;"
              prefWidth="400.0">

            <Label text="🚗" style="-fx-font-size: 80px;"/>

            <Label text="Vehicle ID System"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Manage your vehicles with ease"
                   style="-fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.8); -fx-wrap-text: true;"
                   maxWidth="300.0"/>

            <VBox spacing="15.0" alignment="CENTER" style="-fx-padding: 30 0 0 0;">
                <HBox spacing="15.0" alignment="CENTER">
                    <Label text="🔒" style="-fx-font-size: 24px;"/>
                    <Label text="Secure" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                </HBox>
                <HBox spacing="15.0" alignment="CENTER">
                    <Label text="⚡" style="-fx-font-size: 24px;"/>
                    <Label text="Fast" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                </HBox>
                <HBox spacing="15.0" alignment="CENTER">
                    <Label text="💡" style="-fx-font-size: 24px;"/>
                    <Label text="Reliable" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                </HBox>
            </VBox>

        </VBox>

        <!-- Right Side - Login Form -->
        <VBox alignment="CENTER" spacing="20.0"
              style="-fx-background-color: white; -fx-background-radius: 0 20 20 0;"
              prefWidth="500.0">

            <padding>
                <Insets top="40.0" right="60.0" bottom="40.0" left="60.0"/>
            </padding>

            <!-- Title -->
            <Label text="Welcome Back!"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Label text="Please sign in to continue"
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

            <Region VBox.vgrow="ALWAYS" prefHeight="20.0"/>

            <!-- Username Field -->
            <VBox spacing="5.0">
                <Label text="Username" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <HBox spacing="10.0" alignment="CENTER_LEFT"
                      style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 12 15; -fx-border-color: #e0e0e0; -fx-border-radius: 10;">
                    <Label text="👤" style="-fx-font-size: 18px;"/>
                    <TextField fx:id="usernameField" promptText="Enter your username"
                               style="-fx-background-color: transparent; -fx-font-size: 14px;"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Password Field -->
            <VBox spacing="5.0">
                <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <HBox spacing="10.0" alignment="CENTER_LEFT"
                      style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 12 15; -fx-border-color: #e0e0e0; -fx-border-radius: 10;">
                    <Label text="🔒" style="-fx-font-size: 18px;"/>
                    <PasswordField fx:id="passwordField" promptText="Enter your password"
                                   style="-fx-background-color: transparent; -fx-font-size: 14px;"
                                   HBox.hgrow="ALWAYS"/>
                    <Button fx:id="togglePasswordButton" text="👁️"
                            style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 16px;"
                            onAction="#togglePasswordVisibility"/>
                </HBox>
            </VBox>

            <!-- Remember Me & Forgot Password -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <CheckBox fx:id="rememberMeCheckbox" text="Remember me"
                          style="-fx-text-fill: #7f8c8d;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Forgot password?"
                        style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-cursor: hand; -fx-font-weight: bold;"
                        onAction="#handleForgotPassword"/>
            </HBox>

            <!-- Login Button -->
            <Button text="Sign In" onAction="#handleLogin"
                    style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);
                           -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-background-radius: 10; -fx-padding: 15; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(102, 126, 234, 0.4), 10, 0, 0, 5);"
                    maxWidth="Infinity"/>

            <!-- Loading Indicator -->
            <ProgressIndicator fx:id="loadingIndicator" visible="false"
                               style="-fx-progress-color: #667eea;"/>

            <!-- Error Message -->
            <Label fx:id="errorMessage" text="" wrapText="true"
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-alignment: center;"
                   visible="false" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS" prefHeight="20.0"/>

            <!-- Sign Up Link -->
            <HBox alignment="CENTER" spacing="5.0">
                <Label text="Don't have an account?" style="-fx-text-fill: #7f8c8d;"/>
                <Button text="Sign up"
                        style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-cursor: hand; -fx-font-weight: bold;"
                        onAction="#handleSignUp"/>
            </HBox>

        </VBox>

    </HBox>

</StackPane>