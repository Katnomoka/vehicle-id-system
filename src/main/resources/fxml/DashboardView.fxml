<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vehicle.identification.vehicleidsystem.controller.DashboardViewController"
            style="-fx-background-color: #f5f7fa;">

    <!-- Top: Statistics Dashboard -->
    <top>
        <VBox spacing="10" style="-fx-padding: 15px; -fx-background-color: white;">

            <!-- Title Section -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="🚗 Vehicle Dashboard"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lastUpdatedLabel" text="Last updated: --"
                       style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            </HBox>

            <!-- Statistics Cards -->
            <HBox spacing="15" alignment="CENTER">

                <!-- Total Vehicles Card -->
                <VBox alignment="CENTER" spacing="5"
                      style="-fx-background-color: linear-gradient(to bottom, #3498db, #2980b9);
                             -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 3);"
                      HBox.hgrow="ALWAYS" minHeight="120">
                    <Label text="📊" style="-fx-font-size: 32px;"/>
                    <Label fx:id="totalVehiclesLabel" text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Total Vehicles" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                </VBox>

                <!-- Active Vehicles Card -->
                <VBox alignment="CENTER" spacing="5"
                      style="-fx-background-color: linear-gradient(to bottom, #2ecc71, #27ae60);
                             -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 3);"
                      HBox.hgrow="ALWAYS" minHeight="120">
                    <Label text="✅" style="-fx-font-size: 32px;"/>
                    <Label fx:id="activeVehiclesLabel" text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Active Vehicles" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                </VBox>

                <!-- Pending Services Card -->
                <VBox alignment="CENTER" spacing="5"
                      style="-fx-background-color: linear-gradient(to bottom, #f39c12, #e67e22);
                             -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 3);"
                      HBox.hgrow="ALWAYS" minHeight="120">
                    <Label text="🔧" style="-fx-font-size: 32px;"/>
                    <Label fx:id="pendingServicesLabel" text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Pending Services" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                </VBox>

                <!-- Unpaid Violations Card -->
                <VBox alignment="CENTER" spacing="5"
                      style="-fx-background-color: linear-gradient(to bottom, #e74c3c, #c0392b);
                             -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 3);"
                      HBox.hgrow="ALWAYS" minHeight="120">
                    <Label text="⚠️" style="-fx-font-size: 32px;"/>
                    <Label fx:id="unpaidViolationsLabel" text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Unpaid Violations" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                </VBox>

            </HBox>
        </VBox>
    </top>

    <!-- Center: Toolbar and Table -->
    <center>
        <VBox spacing="10" style="-fx-padding: 15px;">

            <!-- Toolbar -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">

                <Button text="🔄 Refresh" onAction="#handleRefresh"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>

                <Button text="➕ Add Vehicle" onAction="#handleAddVehicle"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>

                <Button text="📤 Export Data" onAction="#handleExport"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="🔍 Filter:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TextField fx:id="searchField" promptText="Search by registration, make, or model..."
                           onKeyTyped="#handleSearch"
                           style="-fx-background-radius: 5; -fx-padding: 8 15; -fx-pref-width: 300;"/>

            </HBox>

            <!-- Vehicle Table -->
            <TableView fx:id="vehicleTable"
                       style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"
                                 style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                    <TableColumn fx:id="colRegNumber" text="Registration" prefWidth="130"
                                 style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colMake" text="Make" prefWidth="120"
                                 style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colModel" text="Model" prefWidth="120"
                                 style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colYear" text="Year" prefWidth="80"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colOwner" text="Owner" prefWidth="150"
                                 style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="120"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colServices" text="Services" prefWidth="90"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colViolations" text="Unpaid" prefWidth="90"
                                 style="-fx-alignment: CENTER;"/>
                </columns>
            </TableView>

        </VBox>
    </center>

    <!-- Bottom: Pagination and Info -->
    <bottom>
        <HBox spacing="15" alignment="CENTER"
              style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">

            <Label text="📄 Showing:" style="-fx-font-weight: bold;"/>
            <Label fx:id="showingLabel" text="0 of 0 vehicles" style="-fx-text-fill: #2c3e50;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Pagination fx:id="pagination" style="-fx-padding: 0;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="ℹ️ Double-click row for details" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>

        </HBox>
    </bottom>

</BorderPane>